<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- RevitAPI is referenced transitively by RevitGraphPlugin.csproj but is never
         loaded at test runtime; suppress the missing-reference warning. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RevitGraphPlugin\RevitGraphPlugin.csproj" />
  </ItemGroup>

  <!-- RevitAPI is needed at compile time only so overload resolution can see the
       Document-taking overloads exposed by the plugin (e.g. RevitOwnerHistory.Override).
       Tests never touch a Document at runtime, so we keep the same Private=false /
       ExcludeAssets=runtime stance as the main csproj — the DLL is never deployed
       next to the test assembly. -->
  <PropertyGroup>
    <!-- Same resolution chain as the main csproj (see comments there). -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == '' And '$(RevitInstallPath2025)' != ''">$(RevitInstallPath2025)</RevitInstallPath>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == '' And Exists('D:\Autodesk\Revit $(RevitVersion)\')">D:\Autodesk\Revit $(RevitVersion)\</RevitInstallPath>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == ''">$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\</RevitInstallPath>
    <RevitApiFromNuGet Condition="'$(RevitApiFromNuGet)' == '' And !Exists('$(RevitInstallPath)RevitAPI.dll')">true</RevitApiFromNuGet>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitApiFromNuGet)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)RevitAPI.dll</HintPath>
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitApiFromNuGet)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
