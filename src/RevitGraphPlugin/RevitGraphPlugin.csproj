<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>RevitGraphPlugin</AssemblyName>
    <RootNamespace>RevitGraphPlugin</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Revit 2025 DLLs reference dozens of in-process assemblies (CefSharp, Autodesk.UI.*) that Revit
         itself supplies at runtime. NETCore's reference resolver warns about every one (MSB3277).
         Suppress here; we already pin Private=false so nothing is copied. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Target Revit version. Override per-machine: dotnet build -p:RevitVersion=2026
         (or the RevitVersion environment variable). Drives both the RevitAPI lookup
         and the Addins deploy folder below. -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <!-- Install path resolution, first match wins:
           1. RevitInstallPath (env var or -p:), for non-standard locations
           2. RevitInstallPath2025 (legacy name, kept so existing setups don't break)
           3. D:\Autodesk\Revit <version>\ if it exists (this repo's dev machine)
           4. %ProgramFiles%\Autodesk\Revit <version>\ (Autodesk's default) -->
    <RevitInstallPath Condition="'$(RevitInstallPath)' == '' And '$(RevitInstallPath2025)' != ''">$(RevitInstallPath2025)</RevitInstallPath>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == '' And Exists('D:\Autodesk\Revit $(RevitVersion)\')">D:\Autodesk\Revit $(RevitVersion)\</RevitInstallPath>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == ''">$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\</RevitInstallPath>
    <!-- No matching local install (e.g. building a 2026 package on a 2025-only machine):
         fall back to the Nice3point NuGet packages, which are verbatim copies of the
         Revit API assemblies. Compile-time only — Revit supplies the real DLLs at runtime. -->
    <RevitApiFromNuGet Condition="'$(RevitApiFromNuGet)' == '' And !Exists('$(RevitInstallPath)RevitAPI.dll')">true</RevitApiFromNuGet>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitApiFromNuGet)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)RevitAPI.dll</HintPath>
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitApiFromNuGet)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GeometryGymIFC" Version="0.1.22" />
    <!-- Neo4j.Driver: used ONLY by the direct-write pipeline (Cypher/Direct/CypherEmitter).
         The temp-IFC bridge (Cypher/IfcSnippetSink) does not need it. -->
    <PackageReference Include="Neo4j.Driver" Version="5.26.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="RevitGraphPlugin.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- IFC4 forward-attribute whitelist for the direct-write pipeline (Ifc/Ifc4Schema.cs). -->
    <EmbeddedResource Include="..\..\data\schema\ifc4_attributes.json"
                      LogicalName="RevitGraphPlugin.Schema.ifc4_attributes.json" />
  </ItemGroup>

  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb;$(TargetDir)*.addin" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinsDir)" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="RevitGraphPlugin deployed to $(RevitAddinsDir)" />
  </Target>

</Project>
